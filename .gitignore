# Generated by scripts/build.py — never committed, always rebuilt
site/data.json

# Your private terms, in plaintext. NEVER commit this.
# Only its hashes (scripts/denylist.sha256) belong in the repo.
.denylist.txt

# Local scratch that must not reach a public repo
notes.local.md
*.local.md
.env
.env.*

__pycache__/
*.pyc
.DS_Store

# Android build output and machine-local SDK path.
# gradle/wrapper/gradle-wrapper.jar is deliberately NOT ignored — without it
# ./gradlew cannot bootstrap on a fresh clone.
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.apk
*.aab
